{
  "name": "kevin-yeh-egroup-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "font": "node scripts/build-font.mjs",
    "dev": "npm run font && vite",
    "build": "npm run font && tsc -b && vite build",
    "build:preview": "npm run font && tsc -b && vite build --mode preview-todo",
