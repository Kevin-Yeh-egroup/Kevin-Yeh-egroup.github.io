    "preview": "vite preview",
    "todo": "node scripts/list-todos.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource/huninn": "^5.3.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fontkit": "^2.0.4",
    "oxlint": "^1.81.0",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
